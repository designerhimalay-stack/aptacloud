---
// Base document: fonts, tokens and text presets come from globals.css.
// SEO head: canonical, Open Graph, Twitter card, and site-wide Organization +
// WebSite structured data. Absolute URLs come from `site` + `base` in
// astro.config.mjs, so moving to the production domain only changes the config.
import "../styles/globals.css";
import { BRAND, asset, brandCssVars } from "../brand/brand";

interface Props {
  title: string;
  description: string;
  /** Structured data objects, emitted as application/ld+json. */
  jsonLd?: object[];
  /** Share image (site path, e.g. a page's hero photo); defaults to the brand card. */
  image?: string;
  /** Keep utility pages (404) out of search results. */
  noindex?: boolean;
}

const { title, description, jsonLd = [], image = "/og-image.jpg", noindex = false } = Astro.props;

const abs = (path: string) => new URL(asset(path), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = abs(image);
const home = abs("/");

// Who publishes every page (Organization) and the site itself (WebSite).
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${home}#organization`,
  name: BRAND.name,
  url: home,
  logo: abs("/images/aptacloud-logo-new.webp"),
  email: BRAND.contact.email,
  telephone: BRAND.contact.phones[0].number,
  address: {
    "@type": "PostalAddress",
    streetAddress: "801 E Campbell Rd, Ste 365",
    addressLocality: "Richardson",
    addressRegion: "TX",
    postalCode: "75081",
    addressCountry: "US",
  },
  sameAs: BRAND.social.map((s) => s.href),
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${home}#website`,
  name: BRAND.name,
  url: home,
  publisher: { "@id": `${home}#organization` },
  inLanguage: "en-AU",
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href={asset("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset("/apple-touch-icon.png")} />
    <link rel="sitemap" type="application/xml" href={asset("/sitemap.xml")} />
    <meta name="application-name" content={BRAND.name} />
    <meta name="theme-color" content="#0a0a0a" />
    <style set:html={brandCssVars()} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href={asset("/fonts/GeistMono-400.woff2")} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset("/fonts/Inter-400.woff2")} as="font" type="font/woff2" crossorigin />
    {[organization, website, ...jsonLd].map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
