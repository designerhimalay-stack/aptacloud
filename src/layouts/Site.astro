---
// Site shell for every page: Base document + fixed nav + construction lines +
// footer. Pages put their sections in the default slot (inside <main>).
import Base from "./Base.astro";
import { ConstructionLines } from "../components/layout/ConstructionLines";
import Footer from "../components/layout/Footer.astro";
import { Nav } from "../components/layout/Nav";

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  /** The nav pill (defaults to "Let's talk"). */
  navCta?: { label: string; href: string };
  /** Share image for Open Graph and Twitter (a site path). */
  image?: string;
  noindex?: boolean;
}

const { title, description, jsonLd, navCta, image, noindex } = Astro.props;
---

<Base title={title} description={description} jsonLd={jsonLd} image={image} noindex={noindex}>
  <Nav client:load cta={navCta} />
  <ConstructionLines />
  <main class="relative">
    <slot />
  </main>
  <Footer />
</Base>
