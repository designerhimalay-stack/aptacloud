---
// Agentcraft site — home page.
// Sections are React islands: above-the-fold and the fixed nav hydrate on load,
// everything else when it scrolls near the viewport. The footer is static HTML.
import Base from "../layouts/Base.astro";
import { BRAND } from "../brand/brand";
import { ConstructionLines } from "../components/layout/ConstructionLines";
import Footer from "../components/layout/Footer.astro";
import { Nav } from "../components/layout/Nav";
import { About } from "../components/site/About";
import { Azure } from "../components/site/Azure";
import { CTA } from "../components/site/CTA";
import { Dynamics } from "../components/site/Dynamics";
import { Hero } from "../components/site/Hero";
import { Microsoft } from "../components/site/Microsoft";
import { Partners } from "../components/site/Partners";
import { WhyWorkshop } from "../components/site/WhyWorkshop";
import { Workshop } from "../components/site/Workshop";

// No em dashes or superlatives in metadata either (Content Writing Guidelines 6.2).
const title = `${BRAND.name} | Microsoft Cloud, Data, and AI Consultancy`;
const description = "AptaCloud modernises the systems mid-sized insurance, oil and gas, and construction firms run on, and puts AI to work. Proven on your data first.";
---

<Base title={title} description={description}>
  <Nav client:load />
  <ConstructionLines />
  <main class="relative">
    <Hero client:load />
    <About client:visible />
    <Workshop client:visible />
    <Partners client:visible />
    <WhyWorkshop client:visible />
    <Dynamics client:visible />
    <Microsoft client:visible />
    <Azure client:visible />
    <CTA client:visible />
  </main>
  <Footer />
</Base>
