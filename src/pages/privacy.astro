---
// Privacy policy: placeholder until AptaCloud supplies the approved policy text
// (launch blocker in docs/launch-checklist.md). Kept out of search results until then.
import Site from "../layouts/Site.astro";
import { CTA } from "../components/site/CTA";
import { BRAND, asset } from "../brand/brand";
---

<Site
  title={`Privacy Policy and Your Data | ${BRAND.name}`}
  description={`How ${BRAND.name} collects, uses, and protects the personal information you share with us, and how to reach our team about your data.`}
  noindex
  navCta={{ label: "Let's talk", href: "#contact" }}
>
  <section id="top" class="legal" data-theme="light">
    <div class="wrap">
      <p class="kicker">Legal</p>
      <h1>Privacy policy</h1>
      <p class="lead">
        {BRAND.name}'s full privacy policy is being finalised and will be published on this page. For any question about
        your personal information, email <a href={`mailto:${BRAND.contact.email}`}>{BRAND.contact.email}</a> and our team
        will respond.
      </p>
      <a class="back" href={asset("/")}>Back to the home page</a>
    </div>
  </section>
  <CTA client:visible />
</Site>

<style>
  .legal {
    background: var(--surface-1);
    color: var(--fg);
    padding: 200px 60px 128px;
  }
  .wrap {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0 auto;
    max-width: 1176px;
  }
  .kicker {
    color: var(--accent);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  h1 {
    font-family: var(--ff-inter);
    font-size: 64px;
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.05;
    margin: 0;
  }
  .lead {
    color: var(--fg-muted);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.55;
    margin: 0;
    max-width: 620px;
  }
  .lead a,
  .back {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 5px;
  }
  .back {
    align-self: flex-start;
    font-size: 15px;
    font-weight: 600;
    margin-top: 8px;
  }
  .lead a:hover,
  .back:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
  @media (max-width: 809.98px) {
    .legal { padding: 140px 16px 72px; }
    h1 { font-size: 36px; }
    .lead { font-size: 16px; }
  }
</style>
