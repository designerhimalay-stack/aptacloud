---
// 404: the site shell with a short message and routes back into the site
// (the three industries and the main service areas). Kept out of search results.
import Site from "../layouts/Site.astro";
import { CTA } from "../components/site/CTA";
import { asset } from "../brand/brand";

const routes = [
  { label: "Home", href: asset("/") },
  { label: "Insurance", href: asset("/industry/insurance/") },
  { label: "Oil & Gas", href: asset("/industry/oil-gas/") },
  { label: "Engineering & Construction", href: asset("/industry/engineering-and-construction/") },
  { label: "AI consulting", href: asset("/ai-consulting/") },
  { label: "Microsoft Azure", href: asset("/azure-hosting/") },
  { label: "Blog", href: asset("/blog/") },
];
---

<Site title="Page not found | AptaCloud" description="The page you were looking for has moved or no longer exists." noindex navCta={{ label: "Let's talk", href: "#contact" }}>
  <section id="top" class="nf" data-theme="light">
    <div class="wrap">
      <p class="code">404</p>
      <h1>This page has moved <span>or no longer exists.</span></h1>
      <p class="lead">The link may be out of date. These pages are a good place to pick up from.</p>
      <ul class="routes">
        {routes.map((r) => (
          <li>
            <a href={r.href}>{r.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CTA client:visible />
</Site>

<style>
  .nf {
    background: var(--surface-1);
    color: var(--fg);
    padding: 200px 60px 128px;
  }
  .wrap {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0 auto;
    max-width: 1176px;
  }
  .code {
    color: var(--accent);
    font-family: var(--ff-inter);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  h1 {
    font-family: var(--ff-inter);
    font-size: 64px;
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.05;
    margin: 0;
    max-width: 900px;
  }
  h1 span {
    color: var(--accent);
    display: block;
  }
  .lead {
    color: var(--fg-muted);
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.5;
    margin: 0;
    max-width: 540px;
  }
  .routes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
  }
  .routes a {
    background: #ffffff;
    border-radius: 999px;
    color: var(--fg);
    display: inline-flex;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    padding: 12px 20px;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .routes a:hover {
    background: var(--accent);
    color: #ffffff;
  }
  @media (max-width: 809.98px) {
    .nf { padding: 140px 16px 72px; }
    h1 { font-size: 36px; }
    .lead { font-size: 16px; }
  }
</style>
